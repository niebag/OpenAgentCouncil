{
	"name": "openagentcouncil",
	"version": "0.1.0",
	"description": "A local terminal council for deliberate decisions with Codex and Claude Code.",
	"license": "MIT",
	"type": "module",
	"engines": {
		"node": "24.x"
	},
	"bin": {
		"agentcouncil": "dist/index.js",
		"openagentcouncil": "dist/index.js"
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"format": "biome format --write .",
		"lint": "biome lint .",
		"quality": "npm run format && npm run lint && npm run typecheck",
		"start": "node dist/index.js",
		"test": "npm run build && tsx --test --test-concurrency=1 test/*.test.ts test/*.test.tsx",
		"typecheck": "tsc --noEmit",
		"release:validate": "npm run build && tsx --test test/release.test.ts"
	},
	"dependencies": {
		"@inkjs/ui": "^2.0.0",
		"ink": "^7.1.1",
		"react": "^19.2.0",
		"react-ink-textarea": "0.4.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.2.0",
		"@types/node": "^24.0.0",
		"@types/react": "^19.2.0",
		"ink-testing-library": "^4.0.0",
		"tsx": "^4.20.0",
		"typescript": "^5.9.0"
	}
}
